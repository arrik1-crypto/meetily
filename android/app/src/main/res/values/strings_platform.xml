<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 17 local network permission (LocalNetworkUi). The AI endpoint
         a user runs on their own network, for example an Ollama box at
         192.168.1.20. Android files the permission under "Nearby devices". -->

    <!-- A summary or answer failed because a server on the local network
         could not be reached at all. %1$s is the server's host, as typed in
         Settings (an address such as 192.168.1.20, or a name). -->
    <string name="platform_lan_unreachable">Couldn\'t reach %1$s on your local network. Check that this phone is on the same Wi-Fi as the AI server and that the server is running.</string>
    <!-- As above, when Recap lacks the permission to reach the local network.
         %1$s is the server's host. -->
    <string name="platform_lan_needs_permission">Recap isn\'t allowed to reach devices on your local network, so it couldn\'t connect to %1$s. Allow Nearby devices for Recap in its app settings.</string>
    <!-- After saving settings: the user declined the permission. %1$s is the
         AI endpoint's host. -->
    <string name="platform_lan_denied">Without access to your local network, Recap can\'t reach the AI endpoint at %1$s, so summaries and answers from it will fail. You can allow Nearby devices for Recap in its app settings.</string>
    <!-- Title of the dialog that explains the permission. -->
    <string name="platform_lan_permission_title">Local network access</string>
    <!-- Button: opens the system's settings page for Recap. -->
    <string name="platform_lan_open_settings">App settings</string>
    <!-- Button: closes the dialog without changing anything. -->
    <string name="platform_lan_not_now">Not now</string>

    <!-- Fallbacks shown inside an error message when the error itself gave
         no reason. They complete sentences such as "Export failed: %1$s". -->
    <string name="platform_error_unknown">unknown error</string>
    <!-- No app on the phone could pick a file or folder. -->
    <string name="platform_error_no_picker">no file picker</string>
    <!-- The chosen file could not be opened for writing. -->
    <string name="platform_error_no_destination">could not open destination</string>
    <!-- A file bundled with the app could not be read. -->
    <string name="platform_error_read_failed">read failed</string>
    <!-- A model download stopped without saying why. -->
    <string name="platform_error_network">network error</string>
    <!-- Topic detection's request to the AI failed without saying why. -->
    <string name="platform_error_ai_request">AI request failed</string>

    <!-- The recognizer's error, inside "Recognition error (%1$s), retrying…".
         The first when it gave no reason; the second with Android's error
         number, %1$d. -->
    <string name="platform_status_unknown">unknown</string>
    <string name="platform_status_code">code %1$d</string>

    <!-- Home list: the dateline over today's and yesterday's meetings
         (older days show their date). -->
    <string name="platform_home_today">Today</string>
    <string name="platform_home_yesterday">Yesterday</string>
    <!-- Home list: how many meetings a day holds, beside its dateline. -->
    <plurals name="platform_home_meetings">
        <item quantity="one">%d meeting</item>
        <item quantity="other">%d meetings</item>
    </plurals>
    <!-- Home list: a meeting's meta line, its parts joined with " · ", for
         example "42 lines · 3 speakers · summary ready". -->
    <plurals name="platform_home_lines">
        <item quantity="one">%d line</item>
        <item quantity="other">%d lines</item>
    </plurals>
    <plurals name="platform_home_speakers">
        <item quantity="one">%d speaker</item>
        <item quantity="other">%d speakers</item>
    </plurals>
    <string name="platform_home_summary_ready">summary ready</string>
    <!-- The meta line of a meeting with no transcript, summary or tags. -->
    <string name="platform_home_notes_only">notes only</string>

    <!-- Settings, a speaker-recognition model's card: what the model does,
         between its size and its engine ("110 MB · Speaker ID · sherpa-onnx"). -->
    <string name="platform_model_speaker_id">Speaker ID</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Broadsheet: newsprint set for the web. The serif IS the chrome — the
      whole Material type scale is re-pointed at Source Serif 4, and the
      color roles carry paper/ink/cyan (magenta stays a per-view spot color
      for the recording state, never a theme role).
    -->
    <style name="TextAppearance.Nocturne.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Nocturne.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Theme.Meetily" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- targetSdk 35 enforces edge-to-edge; opt out for now so the
             existing layouts keep their insets (attr ignored below API 35). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Without these the status bar defaults to colorPrimary and reads as
             a solid accent band above the pale surface. -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <!-- Dialogs: appcompat AlertDialog.Builder resolves alertDialogTheme,
             MaterialAlertDialogBuilder resolves materialAlertDialogTheme. Set
             BOTH or dialogs fall back to the unstyled system look. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Nocturne.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Nocturne.Dialog</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_on_container</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_soft</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorSecondaryContainer">@color/surface_soft</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/bg</item>
        <item name="colorSurfaceContainer">@color/surface_soft</item>
        <item name="colorSurfaceContainerHigh">@color/surface_soft</item>
        <item name="colorSurfaceContainerHighest">@color/surface_soft</item>

        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Nocturne.DisplaySmall</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Nocturne.HeadlineSmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Nocturne.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Nocturne.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Nocturne.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Nocturne.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Nocturne.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Nocturne.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Nocturne.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Nocturne.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Nocturne.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Nocturne.LabelSmall</item>
    </style>

    <!-- Dialog identity: without this every AlertDialog renders as an
         unstyled system box that ignores the Nocturne surface, corners and
         type. Applied theme-wide via alertDialogTheme + materialAlertDialogTheme. -->
    <style name="ThemeOverlay.Nocturne.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_soft</item>
        <item name="colorSurfaceContainerHigh">@color/surface_soft</item>
        <item name="android:colorBackground">@color/surface_soft</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Nocturne.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">
            @style/MaterialAlertDialog.Nocturne.Title
        </item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Nocturne.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Nocturne.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Nocturne.DialogButton</item>
    </style>

    <style name="ShapeAppearance.Nocturne.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="MaterialAlertDialog.Nocturne.Title"
        parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAppearance">@style/TextAppearance.Nocturne.TitleMedium</item>
    </style>

    <style name="Widget.Nocturne.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>

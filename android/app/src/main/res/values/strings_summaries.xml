<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Several summaries per meeting, one per summary style (template):
         the row of style pills on the meeting's summary card
         (SummaryVersionsBar). The summary shown is the one shared, exported
         and asked about; the others are kept to switch back to without
         running the AI again. -->

    <!-- The pill that starts another summary; its visible text is a plus sign. -->
    <string name="summaries_new_pill">+</string>
    <string name="summaries_new">New summary with…</string>

    <!-- A summary saved before Recap recorded which style wrote it. -->
    <string name="summaries_label_earlier">Earlier summary</string>
    <!-- A summary whose custom style has since been deleted. -->
    <string name="summaries_label_removed">Deleted style</string>
    <!-- A style with the language its summary is in, shown only when the
         meeting's summaries are in different languages: "Standup (German)". -->
    <string name="summaries_label_language">%1$s (%2$s)</string>

    <!-- What a screen reader hears on a pill; %1$s is a style such as "Sales call". -->
    <string name="summaries_pill_desc">%1$s summary</string>
    <string name="summaries_pill_desc_stale">%1$s summary, out of date</string>
    <!-- What tapping and holding a pill does, to a screen reader. -->
    <string name="summaries_action_show">Show this summary</string>
    <string name="summaries_action_delete">Delete this summary</string>

    <!-- The line under the pills: which summary is shown, and when it was
         written. %1$s is a style, %2$s a date and time. -->
    <string name="summaries_status">Showing the %1$s summary, written %2$s</string>
    <string name="summaries_status_undated">Showing the %1$s summary</string>
    <!-- Said after a kept summary is deleted; %1$s is a style. -->
    <string name="summaries_deleted">%1$s summary deleted</string>

    <!-- Asked before a kept summary is deleted; %1$s is a style. -->
    <string name="summaries_delete_title">Delete the %1$s summary?</string>
    <string name="summaries_delete_message">Its text is deleted from this meeting. The summary shown now, the action items and the transcript stay. This can\'t be undone.</string>
    <string name="summaries_delete_confirm">Delete</string>

    <!-- In the style picker, beside a style that already has a summary:
         choosing it writes that one again. %1$s is the style. -->
    <string name="summaries_picker_has_summary">%1$s · replaces its summary</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The words the exports write into the files around a meeting's own
         content (ExportText): Markdown, PDF, Word and the action items'
         calendar file. They must stay identical to ExportText's defaults
         (ExportTextTest checks it); a translation goes in values-xx. -->

    <!-- Section headings, in the order the exports write them. -->
    <string name="exporttext_summary">Summary</string>
    <string name="exporttext_action_items">Action items</string>
    <string name="exporttext_notes">Notes</string>
    <string name="exporttext_transcript">Transcript</string>

    <!-- Field labels, colon included; the date, length, names or tags
         follow after a space. -->
    <string name="exporttext_date">Date:</string>
    <string name="exporttext_duration">Duration:</string>
    <string name="exporttext_attendees">Attendees:</string>
    <string name="exporttext_tags">Tags:</string>

    <!-- The Word document's title for a meeting with none. -->
    <string name="exporttext_untitled">Meeting</string>

    <!-- The last line of a Markdown export when the meeting has photos.
         %1$d is how many. Worded as it always has been. -->
    <string name="exporttext_photos_markdown">%1$d photo attachment(s) stored in the Meetily app.</string>
    <!-- The same line in a Word export. %1$d is how many. -->
    <string name="exporttext_photos_word">%1$d photo attachment(s) stored in the Recap app.</string>

    <!-- A task's description in the exported calendar file, followed by a
         space and the meeting's title. -->
    <string name="exporttext_from_meeting">From meeting:</string>
</resources>

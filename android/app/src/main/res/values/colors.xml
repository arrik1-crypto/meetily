<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Broadsheet palette (day edition): newsprint set for the web — paper
      ground, near-black ink, cyan as the one interactive color, magenta
      reserved for the recording state. Values come from the design system's
      token sheet; the night edition overrides live in values-night.
    -->
    <color name="bg">#F3F2F2</color>
    <color name="ink">#201E1D</color>
    <color name="ink_soft">#7D7979</color>
    <color name="surface_soft">#EAE9E9</color>
    <color name="line">#D7D3D3</color>
    <color name="line_strong">#BAB6B6</color>

    <!-- Cyan: base for fills, deep step for text-size accents/links. -->
    <color name="accent">#0088B0</color>
    <color name="accent_on">#FFFFFF</color>
    <color name="accent_container">#CBEEFF</color>
    <color name="accent_on_container">#004961</color>
    <color name="accent_deep">#006786</color>

    <!-- Magenta: the rare second spot color — recording state only. -->
    <color name="record_red">#D6006C</color>
    <color name="rec_pill_bg">#FFDEE6</color>
    <color name="rec_pill_on">#790E3D</color>

    <color name="white">#FFFFFF</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- The line currently being spoken during playback follow. Deliberately
     quieter than bg_line_highlight (the user's own star), with a leading
     accent rule so the eye can find it while the list scrolls. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Report AI output: reason, optional comment, and an opt-in for the
     generated text itself (off by default). See AiReport. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aisafety_report_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aisafety_report_reason_label"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <RadioGroup
            android:id="@+id/aisafety_reason_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/aisafety_reason_offensive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/aisafety_reason_offensive" />

            <RadioButton
                android:id="@+id/aisafety_reason_inaccurate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/aisafety_reason_inaccurate" />

            <RadioButton
                android:id="@+id/aisafety_reason_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/aisafety_reason_privacy" />

            <RadioButton
                android:id="@+id/aisafety_reason_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/aisafety_reason_other" />
        </RadioGroup>

        <EditText
            android:id="@+id/aisafety_report_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="@string/aisafety_report_comment_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="5"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />

        <CheckBox
            android:id="@+id/aisafety_report_include"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="false"
            android:minHeight="48dp"
            android:text="@string/aisafety_report_include_text" />

        <TextView
            android:id="@+id/aisafety_report_include_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aisafety_report_include_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Summary style dialog: depth toggle on top, template list below.
     Depth persists across runs; tapping a template starts generation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/depthToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/depthBrief"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/depth_brief" />

        <Button
            android:id="@+id/depthStandard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/depth_standard" />

        <Button
            android:id="@+id/depthDetailed"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/depth_detailed" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ListView
        android:id="@+id/templateList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:choiceMode="singleChoice" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Find & replace across one meeting: what to find and its replacement,
     the matching options, the areas with what each would change, and a
     status line read out politely as the counts change. See MeetingReplace. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/replace_find_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/replace_find_input"
            android:text="@string/replace_find_label"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/replace_find_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="200"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />

        <TextView
            android:id="@+id/replace_with_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/replace_with_input"
            android:text="@string/replace_with_label"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/replace_with_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:hint="@string/replace_with_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="200"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOutline" />

        <CheckBox
            android:id="@+id/replace_whole_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:minHeight="48dp"
            android:text="@string/replace_whole_word" />

        <CheckBox
            android:id="@+id/replace_match_case"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:minHeight="48dp"
            android:text="@string/replace_match_case" />

        <TextView
            android:id="@+id/replace_areas_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/replace_areas_label"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <CheckBox
            android:id="@+id/replace_area_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/replace_area_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/replace_area_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/replace_area_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/replace_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/replace_stale_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/replace_stale_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

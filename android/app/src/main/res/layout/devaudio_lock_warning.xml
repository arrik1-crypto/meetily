<?xml version="1.0" encoding="utf-8"?>
<!-- Custom panel of the device-audio lock warning (DeviceAudioLockDialog):
     sits under the dialog message, so only the checkbox lives here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp">

    <CheckBox
        android:id="@+id/devaudioDontShowAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/devaudio_lock_dont_show" />
</FrameLayout>
